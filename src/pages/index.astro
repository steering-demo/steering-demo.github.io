---
import Base from '../layouts/Base.astro';
import { SteeringShowcase } from '../components/SteeringShowcase';
import { provenance, scenarios } from '../data/scenarios';

const title = 'Representation Steering Demo';
const description =
  'An interactive demo of representation steering (activation steering). The prompt stays fixed while a steering vector is added to the model\'s internal representation, and the next-token probabilities and the response change with it. Measurements from a small open-weights model, with live re-measurement on a Hugging Face Space.';

// The Hugging Face Space that runs the model. With one set, the page recomputes each scenario
// live; without one, it ships the recorded measurements alone.
//
// The process environment wins (CI, or a one-off `PUBLIC_STEERING_SPACE=... npm run build`),
// then `.env`, which Vite surfaces through import.meta.env. `??` is not enough here: an unset
// GitHub Actions variable arrives as an empty string, not as undefined, and would otherwise
// silently override the committed default.
const spaceUrl =
  [process.env.PUBLIC_STEERING_SPACE, import.meta.env.PUBLIC_STEERING_SPACE]
    .map((value) => (value ?? '').trim())
    .find((value) => value !== '') ?? '';
---

<Base title={title} description={description}>
  {/* Keyboard users land on the slider without tabbing through the header and the tab strip. */}
  <a
    href="#showcase"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-[var(--color-line-strong)] focus:bg-[var(--color-surface-2)] focus:px-3 focus:py-2 focus:text-sm focus:text-[var(--color-ink)]"
  >
    Skip to the demo
  </a>
  <main id="main" class="mx-auto w-full max-w-[68rem] px-4 py-10 sm:px-6 sm:py-14">
    {/* ~72 characters at this size: a comfortable measure for the lede rather than a wide band. */}
    <header class="max-w-[40rem]">
      <h1 class="text-[1.75rem] font-semibold leading-tight tracking-tight sm:text-[2.125rem]">
        {title}
      </h1>
      {/*
        No provenance claim belongs here. This is static HTML outside the island, so it cannot
        follow the result on screen: it went on asserting the numbers were computed in advance
        while the badge immediately below it reported a live run. The badge owns that statement
        and re-renders with the result; this sentence says what the page is for.
      */}
      <p class="mt-3 text-[16px] leading-relaxed text-[var(--color-ink-2)] sm:text-[17px]">
        Move the slider to see how steering changes a model&rsquo;s response to the same prompt.
        Every number below is measured, and the badge says where each one came from.
        {spaceUrl && (
          <>
            {' '}The saved examples were measured in advance; <strong class="font-medium text-[var(--color-ink)]">Run</strong> re-measures
            any of them, or a prompt of your own, live on a{' '}
            <a class="underline underline-offset-2 hover:text-[var(--color-ink)]" href={spaceUrl}>
              Hugging Face Space
            </a>
            .
          </>
        )}
      </p>
    </header>

    <div id="showcase" class="mt-8">
      <SteeringShowcase
        client:load
        scenarios={scenarios}
        provenance={provenance}
        spaceUrl={spaceUrl}
      />
    </div>

    <footer
      class="mt-12 border-t border-[var(--color-line)] pt-6 text-[13px] leading-relaxed text-[var(--color-ink-3)]"
    >
      <p>
        &copy; 2026 <a
          class="text-[var(--color-ink-2)] underline underline-offset-2 hover:text-[var(--color-ink)]"
          href="https://haoranwang18.github.io/">Haoran Wang</a
        >. All rights reserved.
      </p>
    </footer>
  </main>
</Base>
