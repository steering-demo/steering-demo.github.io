---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

const title = 'Inside the Model';
---

<Base
  title={title}
  description="Host page for the interactive representation-steering showcase."
>
  <main class="mx-auto flex min-h-screen w-full max-w-[40rem] flex-col justify-center px-6 py-16">
    <h1 class="text-2xl font-semibold tracking-tight">Inside the Model</h1>
    <p class="mt-3 leading-relaxed text-[var(--color-ink-2)]">
      An interactive explainer for representation steering. Hold the prompt fixed, edit the
      model&rsquo;s internal state, and watch its next word change.
    </p>
    <p class="mt-6">
      <a
        class="inline-block rounded-lg border border-[var(--color-line-strong)] bg-[var(--color-surface-1)] px-4 py-2.5 text-[var(--color-ink)] hover:bg-[var(--color-surface-2)]"
        href={withBase("/steering/")}>Open the showcase &rarr;</a
      >
    </p>
    <p class="mt-8 text-[13px] leading-relaxed text-[var(--color-ink-3)]">
      &copy; 2026 <a
        class="underline underline-offset-2 hover:text-[var(--color-ink-2)]"
        href="https://haoranwang18.github.io/">Haoran Wang</a
      >. All rights reserved.
    </p>
  </main>
</Base>
